        "sass": "^1.69.6",
        "svelte": "^4.2.19",
        "vite": "^6.3.5",
        "wrangler": "^4.17.0"
    },
    "type": "module",
    "dependencies": {
        "@fontsource/exo": "^5.0.18",
        "@fontsource/inter": "^5.0.20",
        "@fortawesome/fontawesome-free": "^6.6.0",
        "bulma": "^1.0.2",
        "prismjs": "^1.30.0"
    }
